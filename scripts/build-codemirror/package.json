{
  "name": "codemirror-bundle-builder",
  "version": "1.0.0",
  "private": true,
  "description": "Build script for the CodeMirror ESM bundle used by the frontend.",
  "scripts": {
    "build": "esbuild bundle-entry.js --bundle --format=esm --outfile=../../frontend/vendor/codemirror/codemirror.bundle.js --minify"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.1",
    "@codemirror/commands": "^6",
    "@codemirror/lang-css": "^6",
    "@codemirror/lang-html": "^6",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6",
    "@codemirror/lang-markdown": "^6",
    "@codemirror/lang-python": "^6",
    "@codemirror/lang-yaml": "^6",
    "@codemirror/language": "^6",
    "@codemirror/legacy-modes": "^6",
    "@codemirror/lint": "^6.9.5",
    "@codemirror/state": "^6",
    "@codemirror/theme-one-dark": "^6",
    "@codemirror/view": "^6",
    "@lezer/highlight": "^1",
    "@replit/codemirror-minimap": "^0.5.2",
    "codemirror-languageserver": "^1.18.1",
    "events": "^3.3.0",
    "thememirror": "^2"
  },
  "devDependencies": {
    "esbuild": "^0.25.12"
  }
}
