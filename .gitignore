.venv_noted/
__pycache__/
data/git-credentials.json

data/environments/
data/.pnpm-store/
data/.renv-cache/
services/airflow/logs/
services/airflow/dags/
services/airflow/config/
services/airflow/data/
services/.env

data/docker-compose.mounts.yml

data/runtimes/**
data/python-builds/
data/docker-compose.mounts.yml

data/NOTED.md
services/airflow/data

data/models/

data/testing/reports/

# Debug instrumentation + per-run probe artifacts. The .py probe scripts
# in data/probes/ and data/experiments/ stay tracked, along with the
# .md reports under data/experiments/. JSON outputs from individual runs
# don't.
data/rerank_dumps/
data/probes/*.json
data/experiments/**/*.json

# Vector store + graph DB state. Regenerated locally from re-ingestion;
# the live files are too large for GitHub (chroma.sqlite3 routinely
# crosses the 100 MB hard limit) and have no business in version control.
data/vectordb/
data/arcadedb/

# Workflow framework runtime state (per-tenant, per-run). The framework
# regenerates everything from workflow inputs; on-disk files here are
# caches, not canonical sources. Keep .gitkeep markers so directory
# anchors survive a fresh clone.
data/tenants/*/workflows/
data/tenants/*/user_tools/
!data/tenants/*/user_tools/.gitkeep

# Archive of skills removed via remove_tool. Pure debris; remove_tool
# regenerates entries here whenever a tool/skill pair is archived. The
# same exclusion pattern is already applied to user_tools/_archive
# implicitly via the parent wildcard above.
data/skills/_archive/

data/domains/bulario/
