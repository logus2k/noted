# Copy this file to .env and adjust the paths for your machine.
# Docker Compose reads .env automatically from the same directory.

# Airflow
AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=./airflow
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# MinIO
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=password

# Terminal access (required to open project terminals)
NOTED_TERMINAL_SECRET=changeme

# Anthropic API (optional - enables Claude models in the assistant dropdown)
ANTHROPIC_API_KEY=

# Mount paths
JENA_WEATHER_PATH=/home/youruser/path/to/jena_weather
